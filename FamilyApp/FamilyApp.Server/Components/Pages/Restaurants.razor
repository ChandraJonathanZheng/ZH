@page "/restaurants"
@attribute [Authorize]
@inject AppDbContext Db
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore

<PageTitle>Nearby Restaurants</PageTitle>

<div class="page-header">
    <h1>🍽️ Nearby Restaurants</h1>
    <AuthorizeView Roles="Family">
        <Authorized>
            <button class="btn btn-primary" @onclick="() => showForm = true">+ Add Restaurant</button>
        </Authorized>
    </AuthorizeView>
</div>

<!-- Search/Filter -->
<div class="filter-bar">
    <input class="form-control search-input" placeholder="Search restaurants..."
           @bind="searchTerm" @bind:event="oninput" />
    <select class="form-control" @bind="selectedCategory">
        <option value="">All Categories</option>
        <option>Indonesian</option>
        <option>Western</option>
        <option>Chinese</option>
        <option>Japanese</option>
        <option>Seafood</option>
        <option>Fast Food</option>
        <option>Cafe</option>
    </select>
</div>

@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <h2>@(editingId == 0 ? "Add" : "Edit") Restaurant</h2>
            <EditForm Model="formModel" OnValidSubmit="SaveRestaurant">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label>Name</label>
                    <InputText @bind-Value="formModel.Name" class="form-control" />
                    <ValidationMessage For="() => formModel.Name" />
                </div>
                <div class="form-group">
                    <label>Address</label>
                    <InputText @bind-Value="formModel.Address" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <InputSelect @bind-Value="formModel.Category" class="form-control">
                        <option value="">-- Select --</option>
                        <option>Indonesian</option>
                        <option>Western</option>
                        <option>Chinese</option>
                        <option>Japanese</option>
                        <option>Seafood</option>
                        <option>Fast Food</option>
                        <option>Cafe</option>
                    </InputSelect>
                </div>
                <div class="form-row">
                    <div class="form-group half">
                        <label>Phone</label>
                        <InputText @bind-Value="formModel.PhoneNumber" class="form-control" />
                    </div>
                    <div class="form-group half">
                        <label>Rating (1-5)</label>
                        <InputNumber @bind-Value="formModel.Rating" class="form-control" min="1" max="5" step="0.1" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Open Hours</label>
                    <InputText @bind-Value="formModel.OpenHours" class="form-control" placeholder="08:00 - 22:00" />
                </div>
                <div class="form-group">
                    <label>Notes</label>
                    <InputTextArea @bind-Value="formModel.Notes" class="form-control" rows="2" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<div class="restaurant-grid">
    @foreach (var r in FilteredRestaurants)
    {
        <div class="restaurant-card">
            <div class="restaurant-header">
                <h3>@r.Name</h3>
                @if (r.Rating.HasValue)
                {
                    <span class="rating">⭐ @r.Rating.Value.ToString("0.0")</span>
                }
            </div>
            <span class="category-badge">@r.Category</span>
            <p class="address">📍 @r.Address</p>
            @if (!string.IsNullOrEmpty(r.OpenHours))
            {
                <p class="hours">🕐 @r.OpenHours</p>
            }
            @if (!string.IsNullOrEmpty(r.PhoneNumber))
            {
                <p class="phone">📞 @r.PhoneNumber</p>
            }
            @if (!string.IsNullOrEmpty(r.Notes))
            {
                <p class="notes">💬 @r.Notes</p>
            }
            <AuthorizeView Roles="Family">
                <Authorized>
                    <div class="card-actions">
                        <button class="btn-icon" @onclick="() => EditRestaurant(r)">✏️</button>
                        <button class="btn-icon btn-danger" @onclick="() => DeleteRestaurant(r.Id)">🗑️</button>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    }
</div>

@if (!FilteredRestaurants.Any())
{
    <div class="empty-state">
        <p>No restaurants found. @(string.IsNullOrEmpty(searchTerm) ? "Add the first one!" : "Try a different search.")</p>
    </div>
}

@code {
    private List<Restaurant> restaurants = [];
    private Restaurant formModel = new();
    private bool showForm = false;
    private int editingId = 0;
    private string searchTerm = "";
    private string selectedCategory = "";

    private IEnumerable<Restaurant> FilteredRestaurants => restaurants
        .Where(r => r.IsActive)
        .Where(r => string.IsNullOrEmpty(searchTerm) ||
                    r.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    r.Address.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrEmpty(selectedCategory) || r.Category == selectedCategory);

    protected override async Task OnInitializedAsync()
    {
        await LoadRestaurants();
    }

    private async Task LoadRestaurants()
    {
        restaurants = await Db.Restaurants.OrderByDescending(r => r.Rating).ToListAsync();
    }

    private async Task SaveRestaurant()
    {
        if (editingId == 0)
        {
            Db.Restaurants.Add(formModel);
        }
        else
        {
            var existing = await Db.Restaurants.FindAsync(editingId);
            if (existing != null)
            {
                existing.Name = formModel.Name;
                existing.Address = formModel.Address;
                existing.Category = formModel.Category;
                existing.PhoneNumber = formModel.PhoneNumber;
                existing.Rating = formModel.Rating;
                existing.OpenHours = formModel.OpenHours;
                existing.Notes = formModel.Notes;
            }
        }
        await Db.SaveChangesAsync();
        await LoadRestaurants();
        CancelForm();
    }

    private void EditRestaurant(Restaurant r)
    {
        editingId = r.Id;
        formModel = new Restaurant
        {
            Name = r.Name, Address = r.Address, Category = r.Category,
            PhoneNumber = r.PhoneNumber, Rating = r.Rating,
            OpenHours = r.OpenHours, Notes = r.Notes
        };
        showForm = true;
    }

    private async Task DeleteRestaurant(int id)
    {
        var r = await Db.Restaurants.FindAsync(id);
        if (r != null) { r.IsActive = false; await Db.SaveChangesAsync(); await LoadRestaurants(); }
    }

    private void CancelForm() { showForm = false; editingId = 0; formModel = new(); }
}
