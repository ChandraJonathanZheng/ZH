@page "/financial"
@attribute [Authorize(Roles = "Family")]
@inject AppDbContext Db
@inject AuthenticationStateProvider AuthState
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

<PageTitle>Financial Report</PageTitle>

<div class="page-header">
    <h1>💰 Financial Report</h1>
    <button class="btn btn-primary" @onclick="() => showForm = true">+ Add Record</button>
</div>

<!-- Month Filter -->
<div class="month-selector">
    <button class="btn btn-icon" @onclick="PrevMonth">‹</button>
    <span class="current-month">@selectedDate.ToString("MMMM yyyy")</span>
    <button class="btn btn-icon" @onclick="NextMonth">›</button>
</div>

<!-- Summary Cards -->
<div class="summary-grid">
    <div class="summary-card income">
        <span class="summary-label">Total Income</span>
        <span class="summary-amount">Rp @TotalIncome.ToString("N0")</span>
    </div>
    <div class="summary-card expense">
        <span class="summary-label">Total Expense</span>
        <span class="summary-amount">Rp @TotalExpense.ToString("N0")</span>
    </div>
    <div class="summary-card tithe">
        <span class="summary-label">Tithe & Offering</span>
        <span class="summary-amount">Rp @TotalTithe.ToString("N0")</span>
    </div>
    <div class="summary-card balance @(Balance >= 0 ? "positive" : "negative")">
        <span class="summary-label">Balance</span>
        <span class="summary-amount">Rp @Balance.ToString("N0")</span>
    </div>
</div>

@if (showForm)
{
    <div class="modal-overlay">
        <div class="modal-card">
            <h2>Add Financial Record</h2>
            <EditForm Model="formModel" OnValidSubmit="SaveRecord">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label>Title</label>
                    <InputText @bind-Value="formModel.Title" class="form-control" />
                    <ValidationMessage For="() => formModel.Title" />
                </div>
                <div class="form-row">
                    <div class="form-group half">
                        <label>Type</label>
                        <InputSelect @bind-Value="formModel.Type" class="form-control" @onchange="OnTypeChanged">
                            <option value="@FinancialType.Income">Income</option>
                            <option value="@FinancialType.Expense">Expense</option>
                        </InputSelect>
                    </div>
                    <div class="form-group half">
                        <label>Amount (Rp)</label>
                        <InputNumber @bind-Value="formModel.Amount" class="form-control" />
                        <ValidationMessage For="() => formModel.Amount" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <InputSelect @bind-Value="formModel.Category" class="form-control">
                        @if (formModel.Type == FinancialType.Income)
                        {
                            <option value="@FinancialCategory.Salary">Salary</option>
                            <option value="@FinancialCategory.Bonus">Bonus</option>
                            <option value="@FinancialCategory.OtherIncome">Other Income</option>
                        }
                        else
                        {
                            <option value="@FinancialCategory.Tithe">Tithe (Persepuluhan)</option>
                            <option value="@FinancialCategory.Offering">Offering (Persembahan)</option>
                            <option value="@FinancialCategory.Food">Food</option>
                            <option value="@FinancialCategory.Transport">Transport</option>
                            <option value="@FinancialCategory.Utilities">Utilities</option>
                            <option value="@FinancialCategory.Education">Education</option>
                            <option value="@FinancialCategory.Health">Health</option>
                            <option value="@FinancialCategory.Entertainment">Entertainment</option>
                            <option value="@FinancialCategory.Savings">Savings</option>
                            <option value="@FinancialCategory.OtherExpense">Other Expense</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-group">
                    <label>Date</label>
                    <InputDate @bind-Value="formModel.Date" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Notes</label>
                    <InputTextArea @bind-Value="formModel.Notes" class="form-control" rows="2" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Records List -->
<div class="records-section">
    <h3>Transactions</h3>
    @foreach (var record in MonthlyRecords.OrderByDescending(r => r.Date))
    {
        <div class="record-item @(record.Type == FinancialType.Income ? "income" : "expense")">
            <div class="record-icon">@GetCategoryIcon(record.Category)</div>
            <div class="record-info">
                <span class="record-title">@record.Title</span>
                <span class="record-category">@record.Category</span>
                <span class="record-date">@record.Date.ToString("MMM dd")</span>
            </div>
            <div class="record-amount @(record.Type == FinancialType.Income ? "text-green" : "text-red")">
                @(record.Type == FinancialType.Income ? "+" : "-") Rp @record.Amount.ToString("N0")
            </div>
            <button class="btn-icon btn-danger" @onclick="() => DeleteRecord(record.Id)">🗑️</button>
        </div>
    }
</div>

@code {
    private List<FinancialRecord> allRecords = [];
    private FinancialRecord formModel = new() { Date = DateTime.Today };
    private bool showForm = false;
    private DateTime selectedDate = DateTime.Today;
    private string? userId;

    private IEnumerable<FinancialRecord> MonthlyRecords => allRecords
        .Where(r => r.Date.Year == selectedDate.Year && r.Date.Month == selectedDate.Month);

    private decimal TotalIncome => MonthlyRecords
        .Where(r => r.Type == FinancialType.Income).Sum(r => r.Amount);

    private decimal TotalExpense => MonthlyRecords
        .Where(r => r.Type == FinancialType.Expense).Sum(r => r.Amount);

    private decimal TotalTithe => MonthlyRecords
        .Where(r => r.Category is FinancialCategory.Tithe or FinancialCategory.Offering)
        .Sum(r => r.Amount);

    private decimal Balance => TotalIncome - TotalExpense;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await LoadRecords();
    }

    private async Task LoadRecords()
    {
        allRecords = await Db.FinancialRecords.OrderByDescending(r => r.Date).ToListAsync();
    }

    private async Task SaveRecord()
    {
        formModel.CreatedByUserId = userId ?? string.Empty;
        Db.FinancialRecords.Add(formModel);
        await Db.SaveChangesAsync();
        await LoadRecords();
        showForm = false;
        formModel = new() { Date = DateTime.Today };
    }

    private async Task DeleteRecord(int id)
    {
        var r = await Db.FinancialRecords.FindAsync(id);
        if (r != null) { Db.FinancialRecords.Remove(r); await Db.SaveChangesAsync(); await LoadRecords(); }
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        formModel.Category = formModel.Type == FinancialType.Income
            ? FinancialCategory.Salary : FinancialCategory.Food;
    }

    private void PrevMonth() => selectedDate = selectedDate.AddMonths(-1);
    private void NextMonth() => selectedDate = selectedDate.AddMonths(1);

    private string GetCategoryIcon(FinancialCategory cat) => cat switch
    {
        FinancialCategory.Salary => "💼",
        FinancialCategory.Bonus => "🎁",
        FinancialCategory.Tithe => "⛪",
        FinancialCategory.Offering => "🙏",
        FinancialCategory.Food => "🍽️",
        FinancialCategory.Transport => "🚗",
        FinancialCategory.Utilities => "💡",
        FinancialCategory.Education => "📚",
        FinancialCategory.Health => "🏥",
        FinancialCategory.Entertainment => "🎬",
        FinancialCategory.Savings => "🏦",
        _ => "💰"
    };
}
